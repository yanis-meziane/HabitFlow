{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitLab API",
    "version": "1.0.0",
    "description": "API REST de gestion d'habitudes. Toutes les routes métier exigent `Authorization: Bearer <JWT>` ; chaque compte ne voit que ses propres habitudes."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Santé"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Habits"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "UNAUTHORIZED",
                  "NOT_FOUND",
                  "EMAIL_ALREADY_USED"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.test"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "MotDePasse123!"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "user",
          "token"
        ],
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          },
          "token": {
            "type": "string",
            "description": "JWT signé, expire après 7 jours"
          }
        }
      },
      "Habit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "507f191e810c19729de860ea"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Marcher"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "example": "#7cb73b",
            "description": "Extra : couleur d'affichage"
          },
          "completions": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "2026-10-07"
            },
            "description": "Extra : jours validés (YYYY-MM-DD)"
          },
          "ownerId": {
            "type": "string"
          }
        }
      },
      "HabitCreate": {
        "type": "object",
        "required": [
          "title",
          "frequency",
          "active"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "example": "#7cb73b"
          }
        },
        "description": "id et ownerId sont interdits (400)."
      },
      "HabitPatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "color": {
            "type": "string"
          }
        },
        "description": "Partiel et non vide ; tout champ inconnu, id ou ownerId est refusé (400)."
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Santé"
        ],
        "summary": "État du serveur (public)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "ok"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Créer un compte",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compte créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email déjà utilisé (EMAIL_ALREADY_USED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Se connecter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/habits": {
      "get": {
        "tags": [
          "Habits"
        ],
        "summary": "Lister mes habitudes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste (vide : items = [])",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Habit"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Habits"
        ],
        "summary": "Créer une habitude",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Habitude créée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/habits/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ObjectId MongoDB sérialisé (24 caractères hexadécimaux)",
          "schema": {
            "type": "string",
            "example": "507f191e810c19729de860ea"
          }
        }
      ],
      "get": {
        "tags": [
          "Habits"
        ],
        "summary": "Détail d'une habitude",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Habitude",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Objet inexistant ou appartenant à un autre compte (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Habits"
        ],
        "summary": "Modifier partiellement une habitude",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Habitude modifiée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Objet inexistant ou appartenant à un autre compte (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Habits"
        ],
        "summary": "Supprimer une habitude",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Supprimée, sans corps"
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Objet inexistant ou appartenant à un autre compte (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/habits/{id}/toggle": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ObjectId MongoDB sérialisé (24 caractères hexadécimaux)",
          "schema": {
            "type": "string",
            "example": "507f191e810c19729de860ea"
          }
        }
      ],
      "post": {
        "tags": [
          "Habits"
        ],
        "summary": "Cocher / décocher un jour (route supplémentaire, bonus journal)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "date"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "example": "2026-10-07",
                    "description": "Date civile réelle YYYY-MM-DD"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Habitude mise à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            }
          },
          "400": {
            "description": "Corps invalide ou identifiant malformé (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Objet inexistant ou appartenant à un autre compte (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
